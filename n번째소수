# -*- coding: utf-8 -*-
import mpmath as mp
mp.mp.dps = 120

def n_from_a(a):
    return mp.ceil(mp.power(10, mp.mpf(a)))

def initial_estimate_x0(a):
    a = mp.mpf(a)
    n = n_from_a(a)
    base = mp.ceil(n * (mp.log(n) + mp.log(mp.log(n)) - 1))

    x_for_count = (mp.mpf(3)/2) * mp.e**(2*a)
    pi_x = mp.ceil(mp.riemannr(x_for_count))              # 개수 올림
    correction = mp.ceil((mp.mpf(3)/2) * pi_x)            # 개수 올림
    subtract = mp.e**a                                     # 지수는 올림 안함

    return mp.ceil(base + correction - subtract)

def adjust_by_R_steps(x0, n_target, steps=4):
    x = mp.mpf(x0)
    for _ in range(steps):
        k = mp.ceil(mp.riemannr(x))   # 개수 올림
        delta = k - n_target
        x = x - delta * mp.log(x)
        if x < 10:
            x = mp.mpf(10)
    return x

def refine_by_findroot(x_start, n_target):
    f = lambda t: mp.riemannr(t) - n_target
    x1 = x_start * mp.mpf("0.999")
    x2 = x_start * mp.mpf("1.001")
    return mp.findroot(f, (x1, x2))

def force_ceil_count(x_guess, n_target):
    """
    최종 정수 x를 선택할 때:
    목표는 ceil(R(x)) == n_target 이 되도록 x를 '내려서' 맞춘다.
    """
    x = int(mp.floor(x_guess))  # 정수로 내림부터 시작(중요)
    while mp.ceil(mp.riemannr(x)) > n_target:
        x -= 1
    # (선택) 더 타이트하게: 가능하면 조금 올려서(최대화) 동일 조건 유지
    while mp.ceil(mp.riemannr(x+1)) == n_target:
        x += 1
    return mp.mpf(x)

def baek_nth_prime_complete(a, steps=4, debug=False):
    a = mp.mpf(a)
    n_target = n_from_a(a)

    x0 = initial_estimate_x0(a)
    x1 = adjust_by_R_steps(x0, n_target, steps=steps)
    x2 = refine_by_findroot(x1, n_target)

    x_final = force_ceil_count(x2, n_target)

    if debug:
        print("n_target =", n_target)
        print("x0 =", x0)
        print("x1 =", x1)
        print("x2(findroot) =", x2)
        print("x_final =", x_final)
        print("R(x_final) =", mp.riemannr(x_final))
        print("ceil(R(x_final)) =", mp.ceil(mp.riemannr(x_final)))

    return x_final

print(baek_nth_prime_complete(5.5, steps=4, debug=True))






